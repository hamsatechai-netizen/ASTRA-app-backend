# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Application -----------------------------------------------------------
APP_NAME="ASTRA Backend"
APP_VERSION=0.1.0
ENVIRONMENT=local        # local | development | staging | production
DEBUG=true

# --- API ---------------------------------------------------------------------
API_V1_PREFIX=/api/v1
# Auth routes live under v2 — see app/api/v2/router.py.
API_V2_PREFIX=/api/v2

# --- Security ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-to-a-random-64-byte-string
ALLOWED_HOSTS=*
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# --- Supabase project API ---------------------------------------------------------
# From your Supabase project: Settings -> API.
SUPABASE_URL=https://your-project-ref.supabase.co
# "anon" / "public" key (Settings -> API -> Project API keys).
SUPABASE_ANON_KEY=change-me
# "service_role" key — SECRET, bypasses Row Level Security. Server-side only,
# never ship this to a client or a public repo.
SUPABASE_SERVICE_ROLE_KEY=change-me

# --- Database (Supabase PostgreSQL) ---------------------------------------------
# From your Supabase project: Settings -> Database -> Connection string.
# Use the "URI" value, changed to the `postgresql+asyncpg://` scheme. If your
# password contains special characters (@ : / # ? % etc.), URL-encode them
# (e.g. `@` -> `%40`, `#` -> `%23`) or the URL will silently mis-parse.
#
# Option A — Supavisor pooler, session mode (port 5432, IPv4, no pgbouncer
# caveats — recommended default): uses a publicly-trusted certificate, so
# it verifies out of the box with no extra configuration.
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Option B — Supavisor pooler, transaction mode (port 6543, best for many
# short-lived serverless connections). Requires DATABASE_USE_PGBOUNCER=true.
# DATABASE_URL=postgresql+asyncpg://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Option C — Direct connection (port 5432). Requires the project's IPv4
# add-on if your host network is IPv4-only. Its certificate is issued by
# Supabase's own private CA, not a public one — full verification needs
# DATABASE_SSL_ROOT_CERT_PATH set below, or you'll hit
# "self-signed certificate in certificate chain".
# DATABASE_URL=postgresql+asyncpg://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:change-me@db.your-project-ref.supabase.co:5432/postgres
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_ECHO=false
DATABASE_SSL_REQUIRED=true
DATABASE_USE_PGBOUNCER=false
# REQUIRED for every option above (A, B, and C) to get full certificate
# verification — Supabase issues certificates for the direct-connection
# host *and* the Supavisor pooler from its own private CA, which no public
# trust store recognizes. Download from the Supabase dashboard: Project
# Settings -> Database -> SSL Configuration (the file is named
# prod-ca-2021.crt) and commit it at certs/prod-ca-2021.crt — a CA cert
# has no private key, so it isn't a secret, and committing it keeps the
# connection reproducible across every environment without an extra
# manual fetch step.
# DATABASE_SSL_ROOT_CERT_PATH=certs/prod-ca-2021.crt
#
# --- LOCAL DEVELOPMENT ONLY --------------------------------------------------
# Stopgap for when you don't have the CA file above yet: still encrypts the
# connection, but skips certificate verification (so a network
# machine-in-the-middle would go undetected). ONLY takes effect when
# ENVIRONMENT is not "production" — app/database/session.py refuses to start
# if both this and ENVIRONMENT=production are set, so it cannot silently
# weaken a production deployment.
#
# >>> MUST be false (or removed) before any deployment. Before shipping:
# >>> 1. Get the real CA file into certs/prod-ca-2021.crt.
# >>> 2. Set DATABASE_SSL_ROOT_CERT_PATH=certs/prod-ca-2021.crt (above).
# >>> 3. Delete/set-false the line below.
DATABASE_SSL_INSECURE=false

# --- SMS provider (Twilio) — used to deliver OTPs -----------------------------------
# From your Twilio Console: https://console.twilio.com.
TWILIO_ACCOUNT_SID=change-me
TWILIO_AUTH_TOKEN=change-me
# A phone number/Messaging Service SID you own in Twilio, E.164 format.
TWILIO_FROM_NUMBER=+15005550006

# --- Logging -------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=false

# --- Rate limiting ---------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60/minute
